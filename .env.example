# Create a .env.local file and paste your TomTom developer key here.
# Get a key from https://developer.tomtom.com/
NEXT_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key

# Google Cloud key with Street View Static API enabled and HTTP referrer restrictions.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
